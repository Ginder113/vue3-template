{
  "name": "mail-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:development": "pnpm type-check && vite build --mode development",
    "build:development-only": "vite build --mode development",
    "build:production": "pnpm type-check && vite build --mode production",
    "build:production-only": "vite build --mode production",
    "build:test": "pnpm type-check && vite build --mode test",
    "build:test-only": "vite build --mode test",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "axios": "^1.10.0",
    "element-plus": "^2.10.5",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.32",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "jiti": "^2.7.0",
    "prettier": "3.5.3",
    "sass": "^1.83.0",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.0.1",
    "vite-plugin-vue-devtools": "^7.6.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
